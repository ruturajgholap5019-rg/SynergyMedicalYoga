# Backend environment template. Never commit real secrets.

PORT=5000
NODE_ENV=development
BACKEND_URL=https://your-backend-domain.example.com
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/synergy_yoga

ACCESS_TOKEN_SECRET=replace_with_64_plus_character_random_access_secret
REFRESH_TOKEN_SECRET=replace_with_64_plus_character_random_refresh_secret

CLIENT_URL=https://your-frontend-vercel-url.vercel.app
ADMIN_URL=https://your-frontend-vercel-url.vercel.app/admin
ALLOWED_ORIGINS=https://your-frontend-vercel-url.vercel.app

# Gmail example: enable 2-Step Verification, then create a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=your-sending-address@gmail.com
CONTACT_RECEIVER_EMAIL=your-inbox@example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Synergy Admin
SEED_ADMIN_PHONE=

LEGACY_ADMIN_NEW_EMAIL=
LEGACY_ADMIN_NEW_PASSWORD=
LEGACY_ADMIN_NEW_NAME=Synergy Admin

# Payment is intentionally skipped for this phase.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX
