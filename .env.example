# Root Docker Compose environment template.
# Copy values into a local .env file. Never commit real secrets.

PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
MONGO_URI=mongodb://mongodb:27017/synergy_yoga

# Generate long random values for production:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_64_plus_character_random_access_secret
REFRESH_TOKEN_SECRET=replace_with_64_plus_character_random_refresh_secret

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Optional email notification settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_RECEIVER_EMAIL=

# Optional media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# One-time admin seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Synergy Admin
SEED_ADMIN_PHONE=

# Payment intentionally not configured in this phase.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX
