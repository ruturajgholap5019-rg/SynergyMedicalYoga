# Root Environment Template for Synergy Medical Yoga
# Copy configurations to backend/.env, fontend/.env, and admin/.env as needed.

# Backend Settings
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
MONGO_URI=mongodb://127.0.0.1:27017/synergy_yoga
ACCESS_TOKEN_SECRET=synergy_super_secret_access_key_2026
REFRESH_TOKEN_SECRET=synergy_super_secret_refresh_key_2026
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Cashfree Payments API v3 (Primary Indian Payment Gateway)
CASHFREE_APP_ID=TEST10091827_EXAMPLE_APP_ID
CASHFREE_SECRET_KEY=TEST_EXAMPLE_SECRET_KEY_2026
CASHFREE_ENV=SANDBOX

# Frontend & Admin Settings
VITE_API_URL=/api
